# ==========================================================
# Konfigurasi Environment Variables — Our Moment
# ==========================================================
# Salin file ini menjadi .env.local untuk konfigurasi lokal Anda:
# cp .env.example .env.local

# 1. Kredensial Supabase (Dapatkan dari Dashboard Supabase -> Project Settings -> API)
# JANGAN PERNAH menaruh service_role key di sini! Gunakan anon key saja.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# 2. Proteksi Password Akses Halaman Awal (Opsional)
VITE_ENABLE_PASSWORD_PROTECTION="false"
VITE_ACCESS_PASSWORD_HASH=""
